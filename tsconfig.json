{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "lucide-react": ["./src/lib/lucide-react.ts"],
      "date-fns": ["./src/lib/date-fns.ts"],
      "date-fns/locale": ["./src/lib/date-fns-locale.ts"]
    }
  },
  "types": ["node", "react", "react-dom"],
  "include": [
    "css-types.d.ts",
    "next-env.d.ts",
    "next.config.ts",
    "drizzle.config.ts",
    "doctor.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/disposable-email-domains/src/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "tools", ".next/dev", "dist", "build", "coverage", ".turbo"]
}
