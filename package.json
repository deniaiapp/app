{
  "name": "deni-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --output src/db/schema/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run --env-file=.env.production drizzle-kit migrate",
    "db:migrate:dev": "bun run --env-file=.env.local db:migrate",
    "db:push": "drizzle-kit push",
    "tools:codename": "bun ./tools/codename-generator.ts",
    "tools:stripe-max-mode": "bun ./tools/stripe-max-mode-setup.ts",
    "tools:commit": "bun ./tools/commit.ts",
    "tools:purge-anonymous": "bun --env-file=.env.production ./tools/purge-anonymous.ts",
    "disposable:refresh": "bun run --filter @deni-ai/disposable-email-domains refresh",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/google": "^4.0.57",
    "@ai-sdk/groq": "^4.0.34",
    "@ai-sdk/openai": "^4.0.51",
    "@ai-sdk/react": "^4.0.87",
    "@ai-sdk/xai": "^4.0.49",
    "@base-ui/react": "^1.7.0",
    "@better-auth-ui/core": "^1.7.14",
    "@better-auth-ui/react": "^1.7.14",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@deni-ai/disposable-email-domains": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.3",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/redis": "^1.38.3",
    "ai": "^7.0.84",
    "better-auth": "^1.7.2",
    "bowser": "^2.14.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk-base": "^1.0.0",
    "cnfast": "^0.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "next": "^16.3.3",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "stripe": "^22.6.0",
    "sucrase": "^3.35.1",
    "superjson": "^2.2.6",
    "uploadthing": "^7.7.4",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "auth": "^1.7.2",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@tanstack/query-core": "5.102.8"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "core-js"
  ]
}
